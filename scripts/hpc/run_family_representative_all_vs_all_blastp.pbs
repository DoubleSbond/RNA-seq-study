#!/bin/bash
#PBS -N detox_selfsim
#PBS -q epyc
#PBS -l select=1:ncpus=8:mem=8gb
#PBS -l walltime=04:00:00

set -euo pipefail

family=${FAMILY:?FAMILY must be set}
source_root=/lustre10/home/tuatchenjh9703/ph/07_family_analysis/_automation_runs/representative_iqtree_20260819T220000JST
run_root=/lustre10/home/tuatchenjh9703/ph/07_family_analysis/_automation_runs/family_representative_all_vs_all_20260821T120000JST
makeblastdb=/home/tuatchenjh9703/miniconda3/bin/makeblastdb
blastp=/home/tuatchenjh9703/miniconda3/bin/blastp
source_fasta="$source_root/$family/${family}_Phoenei_longest_per_gene.fa"
out="$run_root/$family"

mkdir -p "$out/db"
cp "$source_fasta" "$out/${family}_Phoenei_longest_per_gene.fa"

"$makeblastdb" \
  -in "$out/${family}_Phoenei_longest_per_gene.fa" \
  -dbtype prot \
  -parse_seqids \
  -out "$out/db/${family}_representatives" \
  >"$out/makeblastdb.stdout.log" \
  2>"$out/makeblastdb.stderr.log"

"$blastp" \
  -query "$out/${family}_Phoenei_longest_per_gene.fa" \
  -db "$out/db/${family}_representatives" \
  -evalue 1e-3 \
  -seg yes \
  -soft_masking true \
  -max_target_seqs 10000 \
  -num_threads 8 \
  -outfmt '6 qseqid sseqid pident length qlen slen evalue bitscore' \
  -out "$out/${family}_all_vs_all.tsv" \
  >"$out/blastp.stdout.log" \
  2>"$out/blastp.stderr.log"

printf 'qseqid\tsseqid\tpident\tlength\tqlen\tslen\tevalue\tbitscore\tqcov\tscov\n' >"$out/${family}_nonself_edges.tsv"
awk -F '\t' 'BEGIN{OFS="\t"} $1 != $2 {print $0,100*$4/$5,100*$4/$6}' \
  "$out/${family}_all_vs_all.tsv" >>"$out/${family}_nonself_edges.tsv"

printf 'qseqid\tsseqid\tpident\tlength\tqlen\tslen\tevalue\tbitscore\tqcov\tscov\n' >"$out/${family}_edges_e1e5_cov50.tsv"
awk -F '\t' 'BEGIN{OFS="\t"} $1 != $2 && $7 <= 1e-5 && 100*$4/$5 >= 50 && 100*$4/$6 >= 50 {print $0,100*$4/$5,100*$4/$6}' \
  "$out/${family}_all_vs_all.tsv" >>"$out/${family}_edges_e1e5_cov50.tsv"

printf 'family\trepresentatives\tall_hsps\tnonself_hsps\tfiltered_edges\n' >"$out/run_summary.tsv"
printf '%s\t%s\t%s\t%s\t%s\n' \
  "$family" \
  "$(grep -c '^>' "$out/${family}_Phoenei_longest_per_gene.fa")" \
  "$(wc -l <"$out/${family}_all_vs_all.tsv")" \
  "$(( $(wc -l <"$out/${family}_nonself_edges.tsv") - 1 ))" \
  "$(( $(wc -l <"$out/${family}_edges_e1e5_cov50.tsv") - 1 ))" \
  >>"$out/run_summary.tsv"

find "$out" -maxdepth 1 -type f -printf '%f\t%s\n' | sort >"$out/output_inventory.tsv"
(cd "$out" && sha256sum ./* >SHA256SUMS.txt)
