#!/bin/bash
#PBS -N detox_ipr2
#PBS -q epyc
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=48:00:00

set -euo pipefail
family="${FAMILY:?FAMILY must be supplied with qsub -v}"
source_root=/lustre10/home/tuatchenjh9703/ph/07_family_analysis/_automation_runs/sequence_20260819T143800JST
run_root=/lustre10/home/tuatchenjh9703/ph/07_family_analysis/_automation_runs/interproscan_20260819T181500JST
input="${source_root}/${family}/${family}_broad_peptides.fasta"
out="${run_root}/${family}"
interpro=/home/tuatchenjh9703/miniconda3/envs/interproscan/bin/interproscan.sh
test -d "$out"
mkdir -p "$out/temp"
exec >"$out/${family}.stdout.log" 2>"$out/${family}.stderr.log"
date -Is; test -s "$input"
"$interpro" -i "$input" -b "$out/${family}_all_isoforms.interpro" -f TSV,GFF3,XML -goterms -iprlookup -pa -cpu 8 -T "$out/temp"
find "$out" -type f -not -path '*/temp/*' -printf '%P\t%s\n' | sort >"$out/output_inventory.tsv"
sha256sum "$out"/${family}_all_isoforms.interpro.* >"$out/sha256.tsv"
date -Is
