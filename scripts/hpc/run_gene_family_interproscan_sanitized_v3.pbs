#!/bin/bash
#PBS -N detox_ipr3
#PBS -q epyc
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=48:00:00

set -euo pipefail
family="${FAMILY:?FAMILY must be supplied with qsub -v}"
source_root=/lustre10/home/tuatchenjh9703/ph/07_family_analysis/_automation_runs/sequence_20260819T143800JST
run_root=/lustre10/home/tuatchenjh9703/ph/07_family_analysis/_automation_runs/interproscan_sanitized_20260819T184500JST
source_fasta="${source_root}/${family}/${family}_broad_peptides.fasta"
out="${run_root}/${family}"
clean_fasta="$out/${family}_all_isoforms.stop_stripped.pep.fa"
interpro=/home/tuatchenjh9703/miniconda3/envs/interproscan/bin/interproscan.sh

test -d "$out"
exec >"$out/${family}.stdout.log" 2>"$out/${family}.stderr.log"
date -Is; test -s "$source_fasta"
awk '/^>/{print; next} {gsub(/\*/, ""); print}' "$source_fasta" >"$clean_fasta"
printf 'source_fasta\t%s\nsource_peptides\t%s\nsource_stop_characters\t%s\nclean_peptides\t%s\n' \
  "$source_fasta" "$(grep -c '^>' "$source_fasta")" "$(grep -v '^>' "$source_fasta" | tr -cd '*' | wc -c)" "$(grep -c '^>' "$clean_fasta")" >"$out/input_sanitization.tsv"
mkdir -p "$out/temp"
"$interpro" -i "$clean_fasta" -b "$out/${family}_all_isoforms.interpro" -f TSV,GFF3,XML -goterms -iprlookup -pa -cpu 8 -T "$out/temp"
find "$out" -type f -not -path '*/temp/*' -printf '%P\t%s\n' | sort >"$out/output_inventory.tsv"
sha256sum "$out"/${family}_all_isoforms.interpro.* "$clean_fasta" >"$out/sha256.tsv"
date -Is
